guiTypes = {
	containerWindowType = {
		name = "FIU_pirate_gui"
		position = { x = 0 y = 0 }
		size = { width = 500 height = 400 }
		orientation = center
		origo = center

		clipping = no

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_small"
		}

		iconType = {
			name = "FIU_background"
			quadTextureSprite = "GFX_FIU_gui_background"
			position = { x = 2 y = 2 }
			orientation = upper_left
		}

		instantTextboxType = {
			name = "title"
			position = { x = 5 y = 5 }
			font = "hoi_36header"
			borderSize = {x = 0 y = 0}
			text = FIU_pirate_gui_TITLE
			maxWidth = 490
			maxHeight = 90
			Orientation = upper_center
			format = center	
		}

		instantTextboxType = {
			name = "info_desc"
			position = { x = 5 y = 90 }
			font = "hoi_16mbs"
			borderSize = { x = 10 y = 0 }
			text = FIU_pirate_gui_info_desc
			maxWidth = 490
			maxHeight = 200
			fixedsize = yes
			Orientation = upper_center
			format = left
		}

		iconType = {
			name = "FIU_coat_of_arms_thing"
			quadTextureSprite = "GFX_FIU_coat_of_arms"
			position = { x = -157 y = 10 }
			scale = 1.2
			orientation = center
		}

		containerWindowType = {
			name = "FIU_info_container"
			position = { x = -100 y = 140 }
			size = { width = 300 height = 120 }
			orientation = center
			origo = center

			background = {
				name = "Background"
				quadTextureSprite = "GFX_tiled_window_small"
			}

			iconType = {
				name = "FIU_headsup_display"
				quadTextureSprite = "GFX_FIU_headsup_display"
				position = { x = -120 y = -65 }
				scale = 1.3
				orientation = center
				pdx_tooltip = FIU_headsup_display_tt
				pdx_tooltip_delayed = FIU_headsup_display_tt_delayed
			}

			iconType = {
				name = "FIU_compromised_display"
				quadTextureSprite = "GFX_seven_segment_display"
				position = { x = 50 y = -50 }
				orientation = center
				pdx_tooltip = FIU_compromised_display_tt
				pdx_tooltip_delayed = FIU_compromised_display_tt_delayed
			}
		}
	}
	
